SECRET_KEY=replace-with-your-secret
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Shanghai
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./smart_meeting.db

# HTTPS local testing
HTTPS_TEST=0
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
HTTPS_CERT_FILE=.certs/localhost.crt
HTTPS_KEY_FILE=.certs/localhost.key

# LiveKit server settings
# Server-side LiveKit API address (can be internal network host)
LIVEKIT_URL=ws://localhost:7880
# Client-facing LiveKit WebSocket address. For HTTPS pages, use wss://.
# Leave empty to auto-rewrite localhost to current request host.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_MEET_URL=https://meet.livekit.io
# Optional: when egress runs in Docker, map host recording root to a container path
# and set this to that in-container path, e.g. /recordings.
LIVEKIT_EGRESS_OUTPUT_ROOT=

# Realtime meeting AI defaults (OpenAI / VolcEngine)
# Provider: openai | volcengine
REALTIME_BOT_DEFAULT_PROVIDER=openai
REALTIME_BOT_DEFAULT_BASE_URL=https://api.openai.com
REALTIME_BOT_DEFAULT_MODEL=gpt-realtime
REALTIME_BOT_DEFAULT_VOLC_MODEL=2.2.0.0
REALTIME_BOT_DEFAULT_VOICE=marin
REALTIME_BOT_DEFAULT_DISPLAY_NAME=Realtime Voice Assistant
REALTIME_BOT_DEFAULT_API_KEY=
REALTIME_BOT_DEFAULT_VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
REALTIME_BOT_DEFAULT_VOLC_APP_ID=
REALTIME_BOT_DEFAULT_VOLC_APP_KEY=PlgvMymc7f3tQnJ6
REALTIME_BOT_DEFAULT_VOLC_ACCESS_KEY=
REALTIME_BOT_DEFAULT_VOLC_RESOURCE_ID=volc.speech.dialog
REALTIME_BOT_DEFAULT_VOLC_UID=
# Volc speaker defaults by model:
# - O2.0 (model=1.2.1.1) uses jupiter voices
# - SC2.0 (model=2.2.0.0) usually uses saturn_* clone voices; leave empty to let server default
REALTIME_BOT_DEFAULT_VOLC_O_SPEAKER=zh_female_vv_jupiter_bigtts
REALTIME_BOT_DEFAULT_VOLC_SC_SPEAKER=
# Audio input mode: audio_file | push_to_talk | mic_silence (keep_alive kept for backward compatibility)
REALTIME_BOT_VOLC_AUDIO_INPUT_MODE=push_to_talk
# Volc request JSON compression: none | gzip
REALTIME_BOT_VOLC_JSON_COMPRESSION=none
REALTIME_BOT_VOLC_AUDIO_CHUNK_BYTES=640
# For buffered-upload ingress, set 0 to reduce latency; keep 20 for strict realtime pacing.
REALTIME_BOT_VOLC_AUDIO_CHUNK_INTERVAL_MS=0
# Enable detailed VolcEngine realtime WS event logs (outgoing/incoming JSON events, audio frames summarized)
REALTIME_BOT_VOLC_DEBUG_EVENTS=0
# Max chars kept when printing debug payload content
REALTIME_BOT_VOLC_DEBUG_EVENTS_MAX_PAYLOAD_CHARS=2000
REALTIME_BOT_WS_CONNECT_TIMEOUT_SECONDS=10
REALTIME_BOT_RESPONSE_TIMEOUT_SECONDS=20

# China Science and Technology Cloud Passport OAuth
TECHCLOUD_OAUTH_CLIENT_ID=
TECHCLOUD_OAUTH_CLIENT_SECRET=
TECHCLOUD_OAUTH_REDIRECT_URI=https://meeting.chipgpt.chat/callback
TECHCLOUD_OAUTH_AUTHORIZE_URL=https://passport.escience.cn/oauth2/authorize
TECHCLOUD_OAUTH_TOKEN_URL=https://passport.escience.cn/oauth2/token
TECHCLOUD_OAUTH_SCOPE=
TECHCLOUD_OAUTH_THEME=full
TECHCLOUD_OAUTH_LOGOUT_URL=https://passport.escience.cn/logout
TECHCLOUD_OAUTH_LOGOUT_REDIRECT_PARAM=https://meeting.chipgpt.chat
