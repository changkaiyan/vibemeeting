SECRET_KEY=replace-with-your-secret
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Shanghai
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./smart_meeting.db

# HTTPS local testing
HTTPS_TEST=0
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
HTTPS_CERT_FILE=.certs/localhost.crt
HTTPS_KEY_FILE=.certs/localhost.key

# LiveKit server settings
# Server-side LiveKit API address (can be internal network host)
LIVEKIT_URL=ws://localhost:7880
# Client-facing LiveKit WebSocket address. For HTTPS pages, use wss://.
# Leave empty to auto-rewrite localhost to current request host.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_MEET_URL=https://meet.livekit.io
# Optional: when egress runs in Docker, map host recording root to a container path
# and set this to that in-container path, e.g. /recordings.
LIVEKIT_EGRESS_OUTPUT_ROOT=

# Meeting local-development integrations
# MEETING_STT_PROVIDER currently affects uploaded-audio transcription mode.
# Realtime meeting transcription uses MEETING_REALTIME_STT_WORKER_URL directly.
MEETING_STT_PROVIDER=
MEETING_REALTIME_STT_WORKER_URL=
MEETING_AGENT_BRIDGE_MODE=disabled
MEETING_AGENT_BRIDGE_URL=
MEETING_AGENT_BRIDGE_TIMEOUT_SECONDS=20

# China Science and Technology Cloud Passport OAuth
TECHCLOUD_OAUTH_CLIENT_ID=
TECHCLOUD_OAUTH_CLIENT_SECRET=
TECHCLOUD_OAUTH_REDIRECT_URI=https://meeting.chipgpt.chat/callback
TECHCLOUD_OAUTH_AUTHORIZE_URL=https://passport.escience.cn/oauth2/authorize
TECHCLOUD_OAUTH_TOKEN_URL=https://passport.escience.cn/oauth2/token
TECHCLOUD_OAUTH_SCOPE=
TECHCLOUD_OAUTH_THEME=full
TECHCLOUD_OAUTH_LOGOUT_URL=https://passport.escience.cn/logout
TECHCLOUD_OAUTH_LOGOUT_REDIRECT_PARAM=WebServerURL

# Standalone STT worker defaults
STT_WORKER_HOST=127.0.0.1
STT_WORKER_PORT=8765
STT_WORKER_PROVIDER=mock
STT_WORKER_MODEL_SIZE=small
STT_WORKER_COMPUTE_TYPE=int8
STT_WORKER_LANGUAGE=zh
